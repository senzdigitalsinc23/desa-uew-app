# ─── DESA UEW Staging Environment ────────────────────────────────────
#
# Copy this file to .env and fill in the values before running:
#   docker compose up -d
#
# Required: DB_ROOT_PASS, JWT_SECRET, API_KEY, API_SECRET, S3_*
#

# ── Application ──────────────────────────────────────────────────────
APP_NAME=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://desaseek.senzdigitals.dpdns.org   # <-- change to your domain

# ── Nginx ───────────────────────────────────────────────────────────
NGINX_PORT=80

# ── Database ────────────────────────────────────────────────────────
DB_NAME=desa_db
DB_ROOT_PASS=change_me_root_pass
DB_USER=desa_user
DB_PASS=change_me_desa_pass

# ── JWT & API Auth ──────────────────────────────────────────────────
JWT_SECRET=generate_a_64_char_random_hex_string_here
API_KEY=generate_a_random_api_key_here
API_SECRET=generate_a_random_api_secret_here

# ── S3 / File Storage ───────────────────────────────────────────────
FILESYSTEM_DISK=s3
S3_BUCKET=desa-stores
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_URL=https://desa-stores.s3.us-east-1.amazonaws.com
S3_ACL=public-read

# ── Upload ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip,mp4,mp3

# ── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://desaseek.senzdigitals.dpdns.org
