# ─── Data Storage Configuration ───────────────────────────────────────
#
# Set DATA_SOURCE to control where app data is read from and written to:
#
#   local_files  → Data stored in browser IndexedDB.
#                   Export/import JSON files to move data between machines.
#                   This is the default and works without any backend.
#
#   api_access   → Data fetched from and persisted to a REST API.
#                   Requires VITE_API_BASE_URI to be set.
#
# When switching modes, rebuild the app (npm run build) for the change to take effect.
#
# ─── API Configuration (only used when DATA_SOURCE = api_access) ──────
# Base URL for the backend API. Example: http://localhost:3000/api
# Endpoints expected:
#   GET    /data/centers
#   GET    /data/announcements
#   GET    /data/mockData
#   GET    /data/hubData
#   POST   /data/centers   (body: data)
#   POST   /data/announcements
#   POST   /data/mockData
#   POST   /data/hubData
#   POST   /data/reset     (body: {})
VITE_DATA_SOURCE=local_files
VITE_API_BASE_URI=
